# =====================================================================
#  로컬 개발용 Worker 비밀값 · 설정 (wrangler dev 가 읽습니다)
#      cp .dev.vars.example .dev.vars
#  .dev.vars 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다.
#  운영 값은 Cloudflare 대시보드 → Worker → Settings → Variables and secrets 에 등록하세요.
# =====================================================================

# 1 이면 메일을 실제로 보내지 않고 wrangler dev 터미널에 출력합니다.
# 회원가입 인증번호도 터미널에서 확인할 수 있습니다.
MAIL_DEV_LOG=1

# next dev(3000) 에서 API(8787)를 부를 때 허용할 주소
DEV_ORIGINS=http://localhost:3000

# 실제 메일 발송을 시험하려면 MAIL_DEV_LOG 를 지우고 채우세요
# SMTP_PASS=

# 캡차를 시험할 때만 (Cloudflare 테스트용 비밀키: 1x0000000000000000000000000000000AA)
# TURNSTILE_SECRET_KEY=
