# =====================================================================
#  ICHI 홈페이지 환경변수
#  이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
#      cp .env.example .env.local
#  .env.local 은 .gitignore 에 있어 GitHub 에 올라가지 않습니다.
# =====================================================================

# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# 사이트 주소 (sitemap · OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=https://www.ichi.kr

# ---------------------------------------------------------------------
#  ⚠️ service_role 키는 여기에 넣지 마세요.
#     NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저에 그대로 노출됩니다.
#     service_role 키는 RLS 를 무시하므로 노출되면 DB 전체가 열립니다.
#     서버에서만 쓸 값은 Supabase Edge Function 의 secret 으로 관리하세요.
# ---------------------------------------------------------------------
