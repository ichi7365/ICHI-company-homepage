# =====================================================================
#  ICHI 홈페이지 화면(Next.js) 환경변수
#  이 파일을 복사해서 .env.local 을 만들고 실제 값을 채우세요.
#      cp .env.example .env.local
#  .env.local 은 .gitignore 에 있어 GitHub 에 올라가지 않습니다.
#
#  서버(Worker) 쪽 비밀값은 여기가 아니라 .dev.vars 에 넣습니다 (.dev.vars.example 참고).
#  NEXT_PUBLIC_ 값은 빌드할 때 코드에 박혀 브라우저에서 누구나 볼 수 있습니다.
# =====================================================================

# 사이트 주소 (sitemap · OG 이미지 절대경로에 사용)
NEXT_PUBLIC_SITE_URL=https://www.ichi.kr
