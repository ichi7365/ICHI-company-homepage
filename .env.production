# =====================================================================
#  운영 빌드용 환경변수 (next build 시 자동으로 읽힙니다)
#
#  Cloudflare 의 Worker 는 정적 자산만 서빙하므로 실행 시점 변수를 넣을 수
#  없습니다. NEXT_PUBLIC_ 값은 어차피 빌드 시점에 코드에 박히므로
#  이 파일로 관리합니다.
#
#  ⚠️ 여기에는 공개돼도 되는 값만 넣으세요.
#     NEXT_PUBLIC_ 로 시작하는 값은 브라우저에서 누구나 볼 수 있습니다.
#     Publishable key(구 anon)는 공개용으로 설계된 값이고, 실제 보호는 RLS 가 합니다.
#     Secret key(구 service_role)는 절대 넣지 마세요.
#
#  개인 개발 환경에서 다른 값을 쓰려면 .env.local 을 만드세요 (git 제외됨).
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=https://uvirtwlesaoqqeowfays.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable__yS-ncN0yDd7UUWf48AcnQ_SYG9ogOY
NEXT_PUBLIC_SITE_URL=https://ichi-company-homepage.ichi-075.workers.dev
