{
  "name": "ichi-company-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "wrangler dev --port 8787",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "next build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply ichi-homepage-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ichi-homepage-db --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts --include-env=false",
    "check:worker": "wrangler types worker/worker-configuration.d.ts --include-env=false && tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  }
}
